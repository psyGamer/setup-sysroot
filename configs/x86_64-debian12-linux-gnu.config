CT_CONFIG_VERSION="4"
CT_OBSOLETE=y
CT_PREFIX_DIR="${CT_PREFIX:?}/${CT_HOST:+HOST-${CT_HOST}/}${CT_TARGET}"
CT_ARCH_X86=y
CT_ARCH_64=y
CT_TARGET_VENDOR="debian12"
CT_KERNEL_LINUX=y
CT_LINUX_V_6_1=y
CT_BINUTILS_V_2_40=y
CT_BINUTILS_PLUGINS=y
CT_GLIBC_V_2_36=y
CT_GLIBC_KERNEL_VERSION_NONE=y
CT_GCC_V_11=y
CT_CC_GCC_LNK_HASH_STYLE_BOTH=y
CT_CC_LANG_CXX=y
CT_GMP_EXTRA_CFLAGS="-std=gnu17"
CT_NCURSES_EXTRA_CFLAGS="-std=gnu17"
CT_COMP_TOOLS_MAKE=y
CT_MAKE_V_4_3=y
CT_MAKE_GNUMAKE_SYMLINK=y
